# GEMINI_API_KEY: Optional for future automated evaluation / server-side tasks.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected in AI Studio preview.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# PUBLIC GOOGLE DRIVE API CONFIGURATION (For GitHub Pages: cafinalrevisionpage)
# Paste your restricted Google Drive API key (HTTP referrer restricted to your
# GitHub Pages domain) and your 5 public "Anyone with link can view" folder IDs.
# ---------------------------------------------------------------------------
VITE_GOOGLE_DRIVE_API_KEY=""

# Root Drive Folder IDs for each CA Final subject (from the folder URL after /folders/)
VITE_DRIVE_FOLDER_FR=""
VITE_DRIVE_FOLDER_AUDIT=""
VITE_DRIVE_FOLDER_AFM=""
VITE_DRIVE_FOLDER_IDT=""
VITE_DRIVE_FOLDER_DT=""

# Optional: Single parent folder containing all 5 subject folders
VITE_DRIVE_ROOT_FOLDER_ID=""

# ---------------------------------------------------------------------------
# FREE GOOGLE APPS SCRIPT WEBHOOKS (Zero Paid APIs — Keeps Sheet & Drive Private)
# Deploy docs/google-apps-script-feedback.gs as a Web App ("Execute as: Me",
# "Who has access: Anyone") and paste the Web App /exec URL below.
# ---------------------------------------------------------------------------
VITE_FEEDBACK_SCRIPT_URL=""
